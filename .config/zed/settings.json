  "debugger": {
    "dock": "right",
  },
  "file_scan_exclusions": [".jj-worktrees", ".claude/worktrees/"],
  "project_panel": {
    "hide_root": true,
    "dock": "right",
  },
  "languages": {
    "Markdown": {
      "colorize_brackets": false,
      "preferred_line_length": 120,
      "soft_wrap": "editor_width"
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JSX": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
  "diff_view_style": "unified",
  "terminal": {
    "dock": "right",
  },
  "which_key": {
    "delay_ms": 100,
    "enabled": true,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "git_panel": {
    "tree_view": false,
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "sticky_scroll": {
    "enabled": true,
  },
  "vertical_scroll_margin": 10.0,
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "always",
    "max_width_columns": 40,
  },
  "max_tabs": 6,
  "buffer_font_fallbacks": ["JuliaMono Nerd Font Mono", "Fira Code", "Consolas", "Courier New", "monospa"],
  "buffer_font_family": "JuliaMono",
  "file_types": {
    "postgres": ["*.sql"],
    "shellscript": ["*.env"],
    "glsl": ["*.isf"],
  },
  "show_edit_predictions": true,
  "indent_guides": {
    "enabled": true,
  },
  "preferred_line_length": 120,
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "effort": "medium",
        "model": "opencode/deepseek-v4-flash-free",
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
