              "pattern": "^https?://data\\.linz\\.govt\\.nz",
            },
            {
              "pattern": "^https?://basemaps\\.linz\\.govt\\.nz",
            },
          ],
        },
        "terminal": {
          "always_confirm": [
            { "pattern": "sudo\\s" },
            { "pattern": "git\\s+push" },
